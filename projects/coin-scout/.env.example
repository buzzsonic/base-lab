# Discord Webhook URL(DRY_RUN=true なら省略可)
DISCORD_WEBHOOK_URL=

# true にするとDiscord送信せずログに出力のみ
DRY_RUN=true

# 監視対象フィルタ: Binance/Bybitの24h出来高(USD)がこの額以上の銘柄のみ
MIN_CEX_VOLUME_USD=10000000

# CoinGecko集計出来高のみで通過させる場合の倍率(直接値より甘い分の補正)
COINGECKO_VOLUME_MULTIPLIER=2.0

# 出来高急増: 24h出来高が直近7日平均の何倍で発火するか
VOLUME_SPIKE_RATIO=2.0

# 出来高急増と組み合わせる24h価格変動の最低ライン(%)
PRICE_MOVE_MIN_PCT=5.0

# ファンディング偏り: 年率換算(%)の絶対値がこれ以上で発火
FUNDING_APR_ALERT_PCT=30.0

# OI急増: 前回スキャン比の増加率(%)がこれ以上で発火
OI_CHANGE_ALERT_PCT=20.0

# ダイジェストに載せる最大銘柄数
MAX_ALERTS=8

# 出来高ベースライン計算に使う日数
BASELINE_DAYS=7

# 5分収集。比較対象は実測時刻±この許容幅内だけを使用する
OBSERVATION_INTERVAL_MINUTES=5
COMPARISON_TOLERANCE_MINUTES=3

# Funding異常度の銘柄別参照期間。最低24個の1時間標本が貯まるまで蓄積中
FUNDING_REFERENCE_DAYS=14

# 既存の朝夜ダイジェストとは独立した状態変化通知
STATE_ALERTS_ENABLED=false
STATE_ALERT_COOLDOWN_MINUTES=60
STATE_ALERT_MIN_ANOMALY=55
STATE_ALERT_TOP_N=3
LOGIC_VERSION=observability-v2.0

# ローカルdry-run用。0は全銘柄
COLLECTOR_MAX_COINS=0

# recentTradesは返却件数連動のrate weightがあるため全銘柄同時取得しない
TRADE_SAMPLE_COINS_PER_RUN=3
