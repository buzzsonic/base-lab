<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.base-lab.hyperliquid-risk</string>
  <key>WorkingDirectory</key><string>/Users/YOU/base-lab/projects/hyperliquid-wallet-report-bot</string>
  <key>ProgramArguments</key><array>
    <string>/Users/YOU/base-lab/projects/hyperliquid-wallet-report-bot/.venv/bin/python</string>
    <string>-m</string><string>src.main</string><string>risk</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/hyperliquid-risk.log</string>
  <key>StandardErrorPath</key><string>/tmp/hyperliquid-risk.err</string>
</dict></plist>
