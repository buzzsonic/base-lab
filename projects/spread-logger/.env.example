# Discord Webhook URL(DRY_RUN=true なら省略可)
DISCORD_WEBHOOK_URL=

# true にするとDiscord送信せずログに出力のみ(CSV記録は行う)
DRY_RUN=true

# 観測する銘柄(カンマ区切り)。各取引所で実際の取扱があるものだけ自動でフィルタされる
SPREAD_LOGGER_COINS=BTC,ETH,XRP,SOL,DOGE,LTC

# 実効ドル円(国内mid ÷ HLパープ)が参照USDJPYからこの%以上乖離したら発火
EFFECTIVE_JPY_DEV_ALERT_PCT=0.4

# 国内取引所間クロス(bestbid > bestask)がこの%以上で発火
DOMESTIC_CROSS_ALERT_PCT=0.3

# HLファンディング年率換算(%)の絶対値がこれ以上で発火
FUNDING_APR_ALERT_PCT=30.0

# HL現物-パープのベーシス(%)の絶対値がこれ以上で発火
HL_BASIS_ALERT_PCT=1.0

# 同一アラート種別×銘柄のクールダウン(時間)
ALERT_COOLDOWN_HOURS=6.0
